# ── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database (PostgreSQL) ────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowai
DB_USER=flowai_user
DB_PASSWORD=your_strong_password_here

# ── JWT ──────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# ── Anthropic ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── CORS ─────────────────────────────────────────
# Comma-separated allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000
